 from django import forms
 from .models import FreightQuotation, FreightCargo
+from datetime import datetime
 
 class FreightHeaderForm(forms.ModelForm):
     class Meta:
         model = FreightQuotation
         fields = ["business_type", "transport_mode", "service_option", "date", "valid_until", "currency", "payment_term", "notes"]
         widgets = {
             "date": forms.DateInput(attrs={"class": "form-control", "autocomplete": "off"}),
-            "valid_until": forms.DateInput(attrs={"class": "form-control", "autocomplete": "off"}),
+            # pakai text agar bebas format dd-mm-yy di flatpickr
+            "valid_until": forms.TextInput(attrs={"class": "form-control", "autocomplete": "off", "placeholder": "dd-mm-yy"}),
             "notes": forms.Textarea(attrs={"rows": 4, "class": "form-control"}),
         }
+
+    def clean_valid_until(self):
+        """
+        Terima dd-mm-yy dari UI → kembalikan python date.
+        Guard kedua jika ada jalur selain view.
+        """
+        v = self.cleaned_data.get("valid_until")
+        if isinstance(v, str):
+            s = v.strip()
+            for fmt in ("%d-%m-%y", "%Y-%m-%d"):
+                try:
+                    return datetime.strptime(s, fmt).date()
+                except ValueError:
+                    continue
+            raise forms.ValidationError("Format tanggal tidak valid. Gunakan dd-mm-yy.")
+        return v
